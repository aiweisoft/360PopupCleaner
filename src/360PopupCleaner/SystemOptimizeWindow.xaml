<Window x:Class="PopupCleaner.SystemOptimizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="360 系统优化"
        Icon="Assets/app.ico"
        Height="740" Width="940" MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="24,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="系统优化" Style="{StaticResource H1}" />
                    <TextBlock Text="内存整理 · 临时文件清理 · 回收站清理 · 网络优化 · 开机启动项管理（需管理员权限）"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="380">
                    <TextBlock Text="{Binding MemorySummary}"
                               Style="{StaticResource Caption}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,14,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OptimizeAllButton"
                            Content="一键优化"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OptimizeAllCommand}" />
                    <Button x:Name="MemoryButton"
                            Content="内存整理"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding MemoryCommand}" />
                    <Button x:Name="TempButton"
                            Content="清理临时文件"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding TempCommand}" />
                    <Button x:Name="RecycleButton"
                            Content="清空回收站"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding RecycleCommand}" />
                    <Button x:Name="NetworkButton"
                            Content="网络优化"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding NetworkCommand}" />
                    <Button x:Name="RefreshButton"
                            Content="刷新"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <TextBlock Text="一键优化 = 内存整理 → 临时文件清理 → 回收站清理 → 刷新 DNS（不含重置网络协议栈，避免断网风险）。清理类操作执行前会弹窗确认。"
                           Style="{StaticResource Caption}"
                           Margin="2,10,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Stats -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SubCard}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="内存" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SubCard}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="临时文件" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding TempSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SubCard}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="回收站" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding RecycleSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Startup items -->
        <Border Grid.Row="3" Style="{StaticResource TabCard}" Margin="0,14,0,0" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="开机启动项（禁用 = 使用 Windows 自带 StartupApproved 机制，不改动启动命令，可随时启用）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap" />
                <ListView ItemsSource="{Binding StartupItems}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="170" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="位置" Width="170" DisplayMemberBinding="{Binding Location}" />
                            <GridViewColumn Header="命令 / 路径" Width="300" DisplayMemberBinding="{Binding Command}" />
                            <GridViewColumn Header="状态" Width="60" DisplayMemberBinding="{Binding StateText}" />
                            <GridViewColumn Header="操作" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionText}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,3"
                                                FontSize="12"
                                                Command="{Binding ToggleCommand}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="14,10"
                Background="{StaticResource CardSubBrush}"
                CornerRadius="8">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </Border>

        <!-- Log -->
        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="14,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="操作日志"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
