<Window x:Class="PopupCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="360 广告与资讯开关"
        Icon="Assets/app.ico"
        Height="760" Width="960" MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>

        <DataTemplate x:Key="ToggleRow">
            <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding RegistryPath}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Width="120"
                                VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Switch}"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding IsOff, Mode=TwoWay}" />
                        <TextBlock Text="{Binding StateText}"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ValueText, StringFormat=当前值 {0}}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="24,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="360 广告与资讯开关" Style="{StaticResource H1}" />
                    <TextBlock Text="一键关闭 360 安全卫士的广告、资讯与推送弹窗，改动前自动备份、可一键还原"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock Text="{Binding DetectSummary}"
                               Style="{StaticResource Caption}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,14,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CloseAllButton"
                            Content="一键关闭全部"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloseAllCommand}" />
                    <Button x:Name="ApplyButton"
                            Content="应用更改"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding ApplyCommand}" />
                    <Button x:Name="RestoreButton"
                            Content="还原最近备份"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding RestoreCommand}" />
                    <Button x:Name="RefreshButton"
                            Content="刷新"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding RefreshCommand}" />
                    <Button x:Name="OpenBackupButton"
                            Content="打开备份目录"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Command="{Binding OpenBackupFolderCommand}" />
                    <Button x:Name="SystemOptimizeButton"
                            Content="系统优化"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Click="OnOpenSystemOptimize" />
                </StackPanel>

                <TextBlock Text="开关打开 = 关闭该广告 / 推送（需管理员权限，修改会即时写入注册表，改动前自动备份）"
                           Style="{StaticResource Caption}"
                           Margin="2,10,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Ad popup processes -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,14,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="广告弹窗进程"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding AdProcessSummary}"
                               Style="{StaticResource Caption}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AdProcesses}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardSubBrush}"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,8,8">
                                    <TextBlock Text="{Binding Display}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="KillAdButton"
                        Content="结束广告弹窗进程"
                        Style="{StaticResource DangerButton}"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding HasAdProcesses}"
                        Command="{Binding KillAdProcessesCommand}" />
            </Grid>
        </Border>

        <!-- Toggle list -->
        <Border Grid.Row="3"
                Style="{StaticResource TabCard}"
                Margin="0,14,0,0"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedRows}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ToggleRow" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="14,10"
                Background="{StaticResource CardSubBrush}"
                CornerRadius="8">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Log -->
        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="14,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="操作日志"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
